# chatgpt-web-voice local configuration
# Copy this file to .env and replace the password before starting.
# The source checkout defaults to development; the Docker image uses production.

# Gateway login (required)
VOICE_AUTH_USERNAME=admin
VOICE_AUTH_PASSWORD=replace-with-a-long-random-password

# 32-byte key that seals ChatGPT access tokens in SQLite (AES-256-GCM).
# Generate once and keep stable; losing it makes existing sealed tokens unreadable.
#   openssl rand -hex 32
VOICE_TOKEN_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32-output

# Local source listener
VOICE_ENV=development
VOICE_LISTEN_ADDR=0.0.0.0:8090
VOICE_TLS=false

# Docker Compose host port (ignored by `go run` / scripts/dev.sh)
VOICE_PORT=8090

# Local development TLS
# Run `./scripts/dev.sh --tls` to enable the self-signed certificate.
# VOICE_TLS_CERT=/absolute/path/to/server.crt
# VOICE_TLS_KEY=/absolute/path/to/server.key
# VOICE_TLS_CERT_DIR=./data/certs

# Upstream ChatGPT TLS troubleshooting (development only; keep false).
# Production always verifies the upstream certificate and ignores true.
VOICE_SKIP_SSL_VERIFY=false

# SQLite and static-file paths (optional; defaults shown)
VOICE_DATA_DIR=./data
VOICE_DATABASE_FILE=./data/voice.db
VOICE_STATIC_DIR=./static

# Upstream proxy is not a VOICE_* setting. Leave account proxy fields empty to
# follow the process environment (HTTP_PROXY / HTTPS_PROXY / NO_PROXY), or use
# a per-account proxy from the /accounts panel.

# Session and account-pool tuning (optional; defaults shown)
VOICE_AUTH_SESSION_TTL_SECONDS=43200
VOICE_LOGIN_MAX_FAILURES=8
VOICE_LOGIN_WINDOW_SECONDS=900
VOICE_LOGIN_LOCKOUT_SECONDS=900
VOICE_SESSION_TTL_SECONDS=180
VOICE_MAX_ACCOUNT_ATTEMPTS=4

# Upstream client / anti-bot fingerprint (aligned with ChatGPT2API-GO defaults)
# Local `go run` default: tls-client (chrome_120 fallback; no external binary).
# Docker image default: curl-impersonate + bundled edge_101 binary.
# VOICE_UPSTREAM_TRANSPORT=tls-client
# VOICE_TLS_PROFILE=chrome_120
# VOICE_UPSTREAM_TRANSPORT=curl-impersonate
# VOICE_IMPERSONATE=edge_101
# VOICE_CURL_IMPERSONATE_BIN=/app/bin/curl-impersonate/curl_edge101
# Process-global oai-device-id / oai-session-id (auto-generated UUID when unset).
# VOICE_DEVICE_ID=
# VOICE_SESSION_ID=
# Defaults match ChatGPT2API-GO Edge 143 persona + OAI client build:
# VOICE_USER_AGENT=Mozilla/5.0 ... Chrome/143.0.0.0 Safari/537.36 Edg/143.0.0.0
# VOICE_CLIENT_VERSION=prod-be885abbfcfe7b1f511e88b3003d9ee44757fbad
# VOICE_CLIENT_BUILD_NUMBER=5955942

# Logging
VOICE_LOG_FORMAT=json
VOICE_LOG_LEVEL=info
